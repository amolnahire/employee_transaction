
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(false)
    }

    parameters {
        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: true,
            description: 'Run SonarQube analysis'
        )
    }

    environment {
        PROJECT_DIR = 'employee_artifact'

        AZURE_SUBSCRIPTION_ID = 'dd989c95-4624-47b6-9ef5-943f27e6a064'
        AZURE_RESOURCE_GROUP = 'employee-resource'
        AKS_CLUSTER_NAME = 'employee-cluster-test'

        ACR_NAME = 'employeeregistry'
        ACR_LOGIN_SERVER = 'employeeregistry.azurecr.io'
        IMAGE_REPOSITORY = 'employee-artifact'

        SONAR_HOST_URL = 'http://20.112.234.64:9000'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                echo "Workspace: ${WORKSPACE}"

                sh '''
                    set -eu
                    pwd
                    ls -la
                '''
            }
        }

        stage('Validate Project Files') {
            steps {
                sh '''
                    set -eu

                    test -f "$PROJECT_DIR/build.gradle"
                    test -f "$PROJECT_DIR/gradlew"
                    test -f "$PROJECT_DIR/Dockerfile"
                    test -f "$PROJECT_DIR/aks/deployment.yaml"

                    echo "Project files validated."
                '''
            }
        }

        stage('Build and Test') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        set -eu

                        chmod +x gradlew

                        ./gradlew clean test bootJar --no-daemon
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'employee_artifact/**/build/test-results/test/TEST-*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            when {
                expression {
                    params.SONAR_ENABLED
                }
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    dir("${PROJECT_DIR}") {
                        sh '''
                            set -eu

                            echo "Checking SonarQube connectivity..."

                            curl -fsS \
                              --connect-timeout 10 \
                              --max-time 20 \
                              "$SONAR_HOST_URL/api/system/status"

                            echo "Running SonarQube analysis..."

                            ./gradlew sonar \
                              --no-daemon \
                              -Dsonar.host.url="$SONAR_HOST_URL" \
                              -Dsonar.token="$SONAR_TOKEN"

                            echo "SonarQube analysis completed."
                        '''
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            when {
                expression {
                    params.SONAR_ENABLED
                }
            }

            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        stage('Build and Push Docker Image') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'azure-service-principal',
                        usernameVariable: 'AZURE_CLIENT_ID',
                        passwordVariable: 'AZURE_CLIENT_SECRET'
                    ),
                    string(
                        credentialsId: 'azure-tenant-id',
                        variable: 'AZURE_TENANT_ID'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "Logging in to Azure..."

                        az login \
                          --service-principal \
                          --username "$AZURE_CLIENT_ID" \
                          --password "$AZURE_CLIENT_SECRET" \
                          --tenant "$AZURE_TENANT_ID" \
                          --output none

                        az account set \
                          --subscription "$AZURE_SUBSCRIPTION_ID"

                        echo "Logging in to ACR..."
                        az acr login --name "$ACR_NAME"

                        IMAGE="$ACR_LOGIN_SERVER/$IMAGE_REPOSITORY"
                        BUILD_IMAGE="$IMAGE:$BUILD_NUMBER"

                        cd "$PROJECT_DIR"

                        echo "Building image: $BUILD_IMAGE"

                        docker build \
                          -t "$BUILD_IMAGE" \
                          -t "$IMAGE:latest" \
                          .

                        docker push "$BUILD_IMAGE"
                        docker push "$IMAGE:latest"

                        echo "Images pushed successfully."
                        echo "$BUILD_IMAGE"
                    '''
                }
            }
        }

        stage('Deploy to AKS') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'azure-service-principal',
                        usernameVariable: 'AZURE_CLIENT_ID',
                        passwordVariable: 'AZURE_CLIENT_SECRET'
                    ),
                    string(
                        credentialsId: 'azure-tenant-id',
                        variable: 'AZURE_TENANT_ID'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "Logging in to Azure..."

                        az login \
                          --service-principal \
                          --username "$AZURE_CLIENT_ID" \
                          --password "$AZURE_CLIENT_SECRET" \
                          --tenant "$AZURE_TENANT_ID" \
                          --output none

                        az account set \
                          --subscription "$AZURE_SUBSCRIPTION_ID"

                        echo "Getting AKS credentials..."

                        az aks get-credentials \
                          --resource-group "$AZURE_RESOURCE_GROUP" \
                          --name "$AKS_CLUSTER_NAME" \
                          --overwrite-existing

                        kubectl get nodes

                        IMAGE="$ACR_LOGIN_SERVER/$IMAGE_REPOSITORY:$BUILD_NUMBER"

                        echo "Applying Kubernetes deployment..."

                        kubectl apply \
                          -f "$PROJECT_DIR/aks/deployment.yaml"

                        echo "Updating deployment image..."

                        kubectl set image \
                          deployment/employee-artifact \
                          employee-artifact="$IMAGE"

                        echo "Waiting for rollout..."

                        kubectl rollout status \
                          deployment/employee-artifact \
                          --timeout=5m

                        echo "Deployment status:"
                        kubectl get deployment employee-artifact -o wide

                        echo "Pods:"
                        kubectl get pods -o wide

                        echo "Services:"
                        kubectl get services
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Employee Artifact CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Review the failed stage in Console Output.'
        }

        always {
            echo "Build number: ${BUILD_NUMBER}"
            echo "Build result: ${currentBuild.currentResult}"
        }
    }
}
