
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(false)
    }

    parameters {
        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: true,
            description: 'Run SonarQube analysis and Quality Gate'
        )
    }

    environment {
        PROJECT_DIR = 'employee_artifact'

        AZURE_SUBSCRIPTION_ID = 'dd989c95-4624-47b6-9ef5-943f27e6a064'
        AZURE_RESOURCE_GROUP = 'employee-resource'
        AKS_CLUSTER_NAME = 'employee-cluster-test'

        ACR_NAME = 'employeeregistry'
        ACR_LOGIN_SERVER = 'employeeregistry.azurecr.io'
        IMAGE_REPOSITORY = 'employee-artifact'

        SONAR_HOST_URL = 'http://20.112.234.64:9000'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                echo "Workspace: ${WORKSPACE}"

                sh '''
                    set -eu
                    pwd
                    ls -la
                '''
            }
        }

        stage('Validate Project Files') {
            steps {
                sh '''
                    set -eu

                    test -f "$PROJECT_DIR/build.gradle"
                    test -f "$PROJECT_DIR/gradlew"
                    test -f "$PROJECT_DIR/Dockerfile"
                    test -f "$PROJECT_DIR/aks/deployment.yaml"
                    test -f "$PROJECT_DIR/aks/service.yaml"

                    echo "Project files validated."
                '''
            }
        }

        stage('Build and Test') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        set -eu

                        chmod +x gradlew
                        ./gradlew clean test bootJar --no-daemon
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'employee_artifact/**/build/test-results/test/TEST-*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            when {
                expression {
                    params.SONAR_ENABLED
                }
            }

            steps {
                withSonarQubeEnv('sonarqube') {
                    withCredentials([
                        string(
                            credentialsId: 'sonar-token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        dir("${PROJECT_DIR}") {
                            sh '''
                                set -eu

                                echo "Checking SonarQube connectivity..."

                                curl -fsS \
                                  --connect-timeout 10 \
                                  --max-time 20 \
                                  "$SONAR_HOST_URL/api/system/status"

                                echo
                                echo "Running SonarQube analysis..."

                                ./gradlew sonar \
                                  --no-daemon \
                                  -Dsonar.host.url="$SONAR_HOST_URL" \
                                  -Dsonar.token="$SONAR_TOKEN"

                                echo "SonarQube analysis completed."
                            '''
                        }
                    }
                }
            }
        }

stage('SonarQube Quality Gate') {
    when {
        expression {
            params.SONAR_ENABLED
        }
    }

    steps {
        timeout(time: 15, unit: 'MINUTES') {
            script {
                def qualityGate = waitForQualityGate(
                    abortPipeline: false
                )

                echo "SonarQube Quality Gate: ${qualityGate.status}"

                if (qualityGate.status != 'OK') {
                    error(
                        "SonarQube Quality Gate failed: ${qualityGate.status}"
                    )
                }
            }
        }
    }
}


stage('Publish Artifact to Nexus') {
    steps {
        dir('employee_artifact') {
            withCredentials([
                usernamePassword(
                    credentialsId: 'nexus-credentials',
                    usernameVariable: 'NEXUS_USERNAME',
                    passwordVariable: 'NEXUS_PASSWORD'
                )
            ]) {
                withEnv([
                    'NEXUS_URL=http://20.175.104.105:8081/repository/maven-releases/'
                ]) {
                    sh '''
                        set +x

                        ./gradlew publish \
                          -PreleaseVersion=1.0.${BUILD_NUMBER} \
                          --no-daemon
                    '''
                }
            }
        }
    }
}



stage('Trivy Image Scan') {
    steps {
        sh '''
            set -e

            IMAGE="employeeregistry.azurecr.io/employee-artifact:${BUILD_NUMBER}"

            echo "Checking local image: $IMAGE"
            docker image inspect "$IMAGE" >/dev/null

            trivy image \
              --image-src docker \
              --scanners vuln \
              --severity HIGH,CRITICAL \
              --exit-code 1 \
              --ignore-unfixed \
              "$IMAGE"
        '''
    }
}


        stage('Build and Push Docker Image') {
            // when {
            //     branch 'master'
            // }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'azure-service-principal',
                        usernameVariable: 'AZURE_CLIENT_ID',
                        passwordVariable: 'AZURE_CLIENT_SECRET'
                    ),
                    string(
                        credentialsId: 'azure-tenant-id',
                        variable: 'AZURE_TENANT_ID'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "Logging in to Azure..."

                        az login \
                          --service-principal \
                          --username "$AZURE_CLIENT_ID" \
                          --password "$AZURE_CLIENT_SECRET" \
                          --tenant "$AZURE_TENANT_ID" \
                          --output none

                        az account set \
                          --subscription "$AZURE_SUBSCRIPTION_ID"

                        echo "Logging in to Azure Container Registry..."
                        az acr login --name "$ACR_NAME"

                        IMAGE="$ACR_LOGIN_SERVER/$IMAGE_REPOSITORY"
                        BUILD_IMAGE="$IMAGE:$BUILD_NUMBER"

                        echo "Building image: $BUILD_IMAGE"

                        docker build \
                          -t "$BUILD_IMAGE" \
                          -t "$IMAGE:latest" \
                          "$PROJECT_DIR"

                        echo "Pushing build-specific image..."
                        docker push "$BUILD_IMAGE"

                        echo "Pushing latest image..."
                        docker push "$IMAGE:latest"

                        echo "Docker images pushed successfully."
                    '''
                }
            }
        }

        stage('Deploy to AKS') {
// when {
//     branch 'master'
// }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'azure-service-principal',
                        usernameVariable: 'AZURE_CLIENT_ID',
                        passwordVariable: 'AZURE_CLIENT_SECRET'
                    ),
                    string(
                        credentialsId: 'azure-tenant-id',
                        variable: 'AZURE_TENANT_ID'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "Logging in to Azure..."

                        az login \
                          --service-principal \
                          --username "$AZURE_CLIENT_ID" \
                          --password "$AZURE_CLIENT_SECRET" \
                          --tenant "$AZURE_TENANT_ID" \
                          --output none

                        az account set \
                          --subscription "$AZURE_SUBSCRIPTION_ID"

                        echo "Getting AKS credentials..."

                        az aks get-credentials \
                          --resource-group "$AZURE_RESOURCE_GROUP" \
                          --name "$AKS_CLUSTER_NAME" \
                          --overwrite-existing

                        echo "Checking Kubernetes nodes..."
                        kubectl get nodes

                        echo "Applying Kubernetes manifests..."

                        kubectl apply \
                          -f "$PROJECT_DIR/aks/deployment.yaml"

                        kubectl apply \
                          -f "$PROJECT_DIR/aks/service.yaml"

                        IMAGE="$ACR_LOGIN_SERVER/$IMAGE_REPOSITORY:$BUILD_NUMBER"

                        echo "Updating deployment image to $IMAGE"

                        kubectl set image \
                          deployment/employee-artifact \
                          employee-artifact="$IMAGE"

                        echo "Waiting for deployment rollout..."

                        kubectl rollout status \
                          deployment/employee-artifact \
                          --timeout=5m

                        echo "Deployment:"
                        kubectl get deployment employee-artifact -o wide

                        echo "Pods:"
                        kubectl get pods -o wide

                        echo "Services:"
                        kubectl get services

                        echo "AKS deployment completed successfully."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Employee Artifact CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Review the failed stage in Console Output.'
        }

        always {
            echo "Build number: ${BUILD_NUMBER}"
            echo "Build result: ${currentBuild.currentResult}"
        }
    }
}

